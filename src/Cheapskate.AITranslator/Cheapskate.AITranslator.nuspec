<?xml version="1.0"?>
<package>
  <metadata>
    <id>Cheapskate.AITranslator</id>
    <version>$version$</version>
    <authors>Linh Doan</authors>
    <description>Optimizely CMS 12 add-on for creating draft language versions and optionally translating language-specific text properties through Google Gemini, Groq, Azure Translator, DeepL, or a custom provider.</description>
    <summary>Optimizely CMS language-version cloning with optional background AI translation.</summary>
    <projectUrl>https://github.com/birgitzprinz/Cheapskate.AITranslator</projectUrl>
    <repository type="git" url="https://github.com/birgitzprinz/Cheapskate.AITranslator.git" />
    <tags>Optimizely CMS EPiServer CMS 12 localization translation AI language versions content editor</tags>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <icon>skate-icon.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="EPiServer.CMS.Core" version="[12.0.0,13.0.0)" />
        <dependency id="EPiServer.CMS.AspNetCore" version="[12.0.0,13.0.0)" />
        <dependency id="EPiServer.CMS.UI.Core" version="[12.0.0,13.0.0)" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="any/any/modules/_protected/Cheapskate.AITranslator/Cheapskate.AITranslator.zip" buildAction="None" copyToOutput="true" />
    </contentFiles>
  </metadata>
  <files>
    <file src="bin\$configuration$\net8.0\Cheapskate.AITranslator.dll" target="lib\net8.0" />
    <file src="bin\$configuration$\net8.0\Cheapskate.AITranslator.pdb" target="lib\net8.0" />
    <file src="bin\$configuration$\net8.0\Cheapskate.AITranslator.zip" target="contentFiles\any\any\modules\_protected\Cheapskate.AITranslator" />
    <file src="..\..\nuget\README.md" target="README.md" />
    <file src="..\..\LICENSE" target="LICENSE" />
    <file src="..\..\assets\skate-icon.png" target="skate-icon.png" />
    <file src="..\..\assets\skate-icon.png" target="assets\skate-icon.png" />
    <file src="build\net8.0\Cheapskate.AITranslator.targets" target="build\net8.0\Cheapskate.AITranslator.targets" />
  </files>
</package>
